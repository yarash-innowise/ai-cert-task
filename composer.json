{
    "name": "app/user-management-auth",
    "description": "Epic-01 User Management & Authentication",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "enshrined/svg-sanitize": "^1.1",
        "giggsey/libphonenumber-for-php-lite": "^9.0",
        "laminas/laminas-httphandlerrunner": "^2.12",
        "league/route": "^6.2",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "php-di/php-di": "^7.0",
        "psr/log": "^3.0",
        "robmorgan/phinx": "^0.16",
        "symfony/mailer": "^7.3",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
