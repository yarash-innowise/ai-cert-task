{% extends 'email/_base.twig' %}
{% block subject %}Welcome{% if business_name %} to {{ business_name }}{% endif %}{% endblock %}
{% block content %}
  <h1 style="font-size: 20px;">Welcome{% if business_name %} to {{ business_name }}{% endif %}</h1>
  <p>Hello {{ name }},</p>
  <p>Your registration is complete. {{ player_name }} is now a player{% if business_name %} with {{ business_name }}{% endif %}.</p>
  <p>You will receive a separate email to confirm your address. Please confirm it before you sign in.</p>
{% endblock %}
