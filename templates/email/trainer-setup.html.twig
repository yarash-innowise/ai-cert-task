{% extends 'email/_base.twig' %}
{% block subject %}Set up your Trainer account{% endblock %}
{% block content %}
  <h1 style="font-size: 20px;">Welcome to {{ app_name|default('PracticePerfect') }}</h1>
  <p>Hello {{ name }},</p>
  <p>An account for {{ business_name }} has been created for you. Use the button below to choose your password and sign in. The link works once and expires 7 days after it was sent.</p>
  <p><a href="{{ link }}" style="display: inline-block; padding: 12px 24px; background: #0D0D0D; color: #ffffff; border-radius: 8px; text-decoration: none;">Set up my account</a></p>
  <p>If you were not expecting this email, you can ignore it.</p>
{% endblock %}
