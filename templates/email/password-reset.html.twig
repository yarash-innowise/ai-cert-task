{% extends 'email/_base.twig' %}
{% block subject %}Reset your password{% endblock %}
{% block content %}
  <h1 style="font-size: 20px;">Reset your password</h1>
  <p>Hello {{ name }},</p>
  <p>We received a request to reset your password. Use the button below to choose a new one. The link works once and expires 1 hour after it was sent.</p>
  <p><a href="{{ link }}" style="display: inline-block; padding: 12px 24px; background: #0D0D0D; color: #ffffff; border-radius: 8px; text-decoration: none;">Reset password</a></p>
  <p>If you did not ask for this, you can ignore this email; your password stays the same.</p>
{% endblock %}
