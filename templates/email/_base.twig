{#
  Email layout. Convention: every email is a pair
    templates/email/{name}.html.twig  - extends this file, defines `subject` and `content` blocks
    templates/email/{name}.text.twig  - plain-text twin (never HTML-escaped; see TwigFactory)
  The outbox stores only {name}, the recipient and JSON context; subject comes from the HTML `subject` block.
  Never put passwords in an email; use single-use links.
#}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block subject %}{% endblock %}</title>
</head>
<body style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 22px; color: #0D0D0D; background: #F3F3F3; margin: 0; padding: 16px;">
  <main style="max-width: 560px; margin: 0 auto; background: #ffffff; padding: 24px; border-radius: 16px;">
    {% block content %}{% endblock %}
  </main>
  <p style="text-align: center; color: #5E5E5E; font-size: 12px; line-height: 18px;">This is an automated message. Please do not reply.</p>
</body>
</html>
