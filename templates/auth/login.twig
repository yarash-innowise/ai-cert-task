{% extends 'layout/base.twig' %}
{% import 'components/form.twig' as f %}
{% block content %}
  <h1>Sign in</h1>
  {{ f.error_summary(errors) }}
  {% if form_error is defined and form_error %}
    <div class="error-summary" id="error-summary" role="alert" tabindex="-1">
      <p class="error-summary__title">{{ form_error }}</p>
      {% if unverified is defined and unverified %}<p><a href="/verify-email/resend">Send the verification email again</a></p>{% endif %}
    </div>
  {% endif %}
  <form method="post" action="/login" novalidate>
    {{ csrf_field() }}
    {% if return_to %}<input type="hidden" name="return_to" value="{{ return_to }}">{% endif %}
    {{ f.field('email', 'Email', old.email|default(''), errors.email|default(null), 'email', null, true, 'username') }}
    {{ f.field('password', 'Password', '', errors.password|default(null), 'password', null, true, 'current-password') }}
    <button class="button" type="submit">Sign in</button>
  </form>
  <p><a href="/forgot-password">Forgot your password?</a></p>
{% endblock %}
