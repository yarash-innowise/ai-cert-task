{% extends 'layout/base.twig' %}
{% import 'components/form.twig' as f %}
{% block content %}
  <h1>{{ sent ? 'Check your email' : 'Reset your password' }}</h1>
  {% if sent %}
    <p>If that email address belongs to an account, we have sent a link to reset the password. The link works once and expires in 1 hour.</p>
    <p><a href="/login">Back to sign in</a></p>
  {% else %}
    {{ f.error_summary(errors) }}
    <form method="post" action="/forgot-password" novalidate>
      {{ csrf_field() }}
      {{ f.field('email', 'Email', old.email|default(''), errors.email|default(null), 'email', 'We will send a reset link to this address.', true, 'username') }}
      <button class="button" type="submit">Send reset link</button>
    </form>
    <p><a href="/login">Back to sign in</a></p>
  {% endif %}
{% endblock %}
