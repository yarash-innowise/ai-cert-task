{% extends 'layout/base.twig' %}
{% block content %}
  <h1>Who will train with {{ business_name }}?</h1>
  {% if errors.profile_ids|default(null) %}
    <div class="error-summary" id="error-summary" role="alert" tabindex="-1" aria-labelledby="error-summary-title">
      <h2 id="error-summary-title" class="error-summary__title">There is a problem</h2>
      <p><a href="#field-profile_ids">{{ errors.profile_ids }}</a></p>
    </div>
  {% endif %}
  <form method="post" action="/join/{{ code|url_encode }}/who" novalidate>
    {{ csrf_field() }}
    <fieldset class="field" id="field-profile_ids" tabindex="-1">
      <legend>Tick everyone who should be registered</legend>
      {% for option in options %}
        <p>
          <label>
            <input type="checkbox" name="profile_ids[]" value="{{ option.profileId }}"{% if option.alreadyAssociated %} disabled{% endif %}>
            {{ option.label }}{% if option.alreadyAssociated %} <span class="caption">(already with {{ business_name }})</span>{% endif %}
          </label>
        </p>
      {% endfor %}
    </fieldset>
    <button class="button" type="submit">Continue</button>
    <a class="button button--secondary" href="/family/">Cancel</a>
  </form>
{% endblock %}
